---
import { business } from '~/lib/site';
import { u } from '~/lib/utils';
interface Props { title: string; text: string }
const { title, text } = Astro.props;
---

<section class="wrap sec-tight" aria-labelledby="cta-h">
  <div class="cta rev">
    <span class="cta-ring a" aria-hidden="true"></span>
    <span class="cta-ring b" aria-hidden="true"></span>
    <h2 class="d2" id="cta-h">{title}</h2>
    <p>{text}</p>
    <div class="cta-actions">
      <a class="btn btn-ink" href={u('/contact/')}><span>Request service</span></a>
      <a class="btn btn-outline-ink" href={business.phoneHref}>
        <span>{business.phoneDisplay}</span>
        <i><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.4 15.4 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.9.6.6 0 1 .4 1 1v3.5c0 .6-.4 1-1 1C10.8 21 3 13.2 3 3.6c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.4.2 2.7.6 3.9.1.4 0 .8-.3 1.1l-2.2 2.2z"/></svg></i>
      </a>
    </div>
  </div>
</section>
